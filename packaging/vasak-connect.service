[Unit]
Description=VasakOS Android device service
Documentation=https://github.com/Vasak-OS/vasak-connect
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/vasak-connect
Restart=on-failure
RestartSec=3

# Este servicio ve el teléfono: sus archivos, su cámara, la lista de lo que
# tiene instalado. Corría sin ninguna restricción, así que se le saca todo lo
# que no usa.
#
# La red es lo primero, y acá sale barato: con el teléfono se habla por USB a
# través de `adb`, no por red. Queda AF_NETLINK porque es por donde udev avisa
# que enchufaste o desenchufaste el aparato —sin eso no se entera de nada—.
RestrictAddressFamilies=AF_UNIX AF_NETLINK

# Y para que eso no rompa `adb`, que es con lo que se habla con el teléfono.
#
# Con el teléfono se habla por USB, pero `adb` tiene además un canal propio
# entre su cliente y su servidor, y por omisión ése es TCP en localhost
# (tcp:5037). Con la red cerrada, ese canal no se puede abrir y adb falla con
# «ADB server didn't ACK» —sin decir que el problema es la red—.
#
# Comprobado: con la restricción y sin esta variable, adb no arranca; con ella,
# levanta su servidor en un socket abstracto y funciona igual.
#
# Se prefiere esto antes que permitir AF_INET porque este servicio ve los
# archivos del teléfono y su cámara: dejarle la red abierta para que hable
# consigo mismo sería un precio alto por una comodidad.
#
# El costo está en que este servidor de adb es distinto del que levanta un `adb`
# corrido a mano en una terminal, y dos servidores se disputan el mismo teléfono.
# Quien use adb a mano y quiera compartir servidor puede exportar la misma
# variable.
Environment=ADB_SERVER_SOCKET=localabstract:vasak-connect-adb

NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# `full` y no `strict`: deja /usr, /boot y /etc de sólo lectura, que es de donde
# vendría un cambio persistente al sistema.
ProtectSystem=full

# Sin `PrivateDevices` ni `MemoryDenyWriteExecute` a propósito: el primero le
# escondería /dev/bus/usb y el /dev/video por donde sale la cámara del teléfono,
# y el segundo lo heredarían los programas que lanza —`adb` entre ellos—, que sí
# generan código en memoria.

[Install]
WantedBy=graphical-session.target
