[Unit]
Description=VasakOS Android device service
Documentation=https://github.com/Vasak-OS/vasak-connect
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/vasak-connect
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
